{
  "name": "agentscribe-desktop",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "node scripts/platform-helper-checks.cjs && node scripts/helper-lifetime-checks.cjs && node scripts/probe.cjs",
    "components": "npm run build && electron . --components --no-audio",
    "preview": "vite --host 127.0.0.1",
    "test:migration": "node scripts/migration-probe.cjs",
    "test:chain": "node scripts/chain-probe.cjs",
    "test:interaction": "node scripts/interaction-probe.cjs",
    "test:audio-adapter": "node scripts/audio-adapter-checks.cjs"
  },
  "dependencies": {
    "marked": "18.1.2",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.0.0",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
